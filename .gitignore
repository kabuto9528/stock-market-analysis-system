# ---- Python 虚拟环境 ----
.venv/
venv/
env/

# ---- 环境变量与密钥 ----
.env
.env.*
!.env.example

# ---- Python / 测试 / 工具缓存 ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Jupyter / 编辑器 / 系统文件 ----
.ipynb_checkpoints/
.vscode/
.idea/
Thumbs.db
desktop.ini

# ---- 行情数据与运行缓存 ----
data/*
!data/.gitkeep

# ---- 模型与实验产物 ----
artifacts/*
!artifacts/.gitkeep
*.pt
*.pth
*.ckpt

# ---- 日志与临时文件 ----
*.log
*.tmp
*.temp
.archive/
.workbuddy/

# ---- 本地论文、文献与写作资料（保留本地文件） ----
/docs/paper/
/docs/thesis/
/docs/答辩源码与模块详解.md
/论文与文献.md
/scripts/assemble_thesis_draft.py
/scripts/build_thesis_assets.py
/scripts/check_thesis_draft.py
/scripts/generate_thesis_docx.js

